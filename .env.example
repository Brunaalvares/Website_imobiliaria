# Supabase Postgres
# Project: https://YOUR_PROJECT_REF.supabase.co
#
# Use o Connection pooler (Transaction) na porta 6543 para a app.
# Use a connection de Session (porta 5432) em DIRECT_URL para migrations.
#
# Importante: no painel Supabase → Database → Network Restrictions,
# permita o IP do servidor (ou desative a restrição em desenvolvimento).

DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Obrigatório em produção (Vercel) para upload de imagens no Storage
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
# Opcional
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_STORAGE_BUCKET="uploads"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-um-segredo-forte-com-openssl-rand-base64-32"

# Apenas desenvolvimento local (fallback se não houver service role)
UPLOAD_DIR="./uploads"

# URL pública do site
NEXT_PUBLIC_APP_URL="http://localhost:3000"
